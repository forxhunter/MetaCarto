# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data
data/
validation_outputs/
*.zip
*.pth
*.json
*.xml

# Logs and temp
*.log
processed_files.txt
temp/
.vscode/
.idea/

# Environment
.env
venv/
env/

# Generated layouts
layout_output/

# The published maps mirror and the Escher fork are tracked as submodules, so
# the parent records which commit of each this work was built against instead
# of ignoring them. Cloning needs --recurse-submodules.

# Generated map output from any run
layout_output*/

# Benchmark results are the evidence behind every number in the paper, so they
# are tracked despite the blanket *.json rule above. They are small, and a
# result that is not diffable cannot show a regression.
!benchmarks/results/*.json

# Local editable-install metadata
*.egg-info/

# Journal templates and manuscript drafts: third-party copyright (OUP
# bioinfo.cls, natbib.bst) and not part of the software.
bioinfomatics/

# Scratch screenshots
error1.png
graph_error.png
hi_test.png

# templates
templates/
# Working notes, not documentation. CLAUDE.md is assistant instructions and
# carries this machine's conda paths; constraints.md was a requirements
# checklist whose binding items now live in layout_algorithm.md under
# "Requirements", which is where the code cites them from.
CLAUDE.md
constraints.md
