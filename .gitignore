# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data
data/
validation_outputs/
*.zip
*.pth
*.json
*.xml

# Logs and temp
*.log
processed_files.txt
temp/
.vscode/
.idea/

# Environment
.env
venv/
env/

# Generated layouts
layout_output/

# Published maps mirror is its own git repository with its own remote
escher_maps_BiGG/

# Escher fork is its own git repository with its own remote
escher/

# Generated map output from any run
layout_output*/

# Benchmark results are the evidence behind every number in the paper, so they
# are tracked despite the blanket *.json rule above. They are small, and a
# result that is not diffable cannot show a regression.
!benchmarks/results/*.json
